# Binance.US API Configuration
# Get your API keys from https://www.binance.us/en/usercenter/settings/api-management
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Trading Configuration
# Comma-separated list of trading pairs (e.g., BTCUSD,ETHUSD,SOLUSD)
TRADING_PAIRS=BTCUSD,ETHUSD

# Risk Management
# Maximum percentage of portfolio to risk per trade (1-10 recommended for moderate risk)
MAX_RISK_PER_TRADE=2

# Maximum number of concurrent open positions
MAX_OPEN_POSITIONS=3

# Stop loss percentage (e.g., 5 means 5% stop loss)
STOP_LOSS_PERCENT=5

# Take profit percentage (e.g., 10 means 10% take profit)
TAKE_PROFIT_PERCENT=10

# Trailing stop percentage (0 to disable)
TRAILING_STOP_PERCENT=2

# Trading Interval (in milliseconds) - how often to check for trading signals
TRADING_INTERVAL=60000

# Strategy Configuration
# Available strategies: RSI, MACD, EMA_CROSSOVER, COMBINED
STRATEGY=COMBINED

# RSI Configuration
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# MACD Configuration
MACD_FAST_PERIOD=12
MACD_SLOW_PERIOD=26
MACD_SIGNAL_PERIOD=9

# EMA Configuration
EMA_SHORT_PERIOD=9
EMA_LONG_PERIOD=21

# Server Configuration
PORT=3000
NODE_ENV=development

# Paper Trading Mode (set to 'true' for testing without real trades)
PAPER_TRADING=true

# Logging
LOG_LEVEL=info
